{
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": false,
  "autoContinueAtUsageLimit": true,
  "autoMemoryEnabled": false,
  "autoUpdatesChannel": "latest",
  "awaySummaryEnabled": false,
  "disableArtifact": true,
  "disableWorkflows": true,
  "enabledPlugins": {
    "greptile@claude-plugins-official": false,
    "supabase@claude-plugins-official": false,
    "playwright@claude-plugins-official": false,
    "serena@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "ll@loonylabs": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/bash-guard.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/select-env.mjs"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "language": "german",
  "permissions": {
    "allow": [
      "Read(~/.claude/**)"
    ],
    "deny": [
      "NotebookEdit",
      "EnterWorktree",
      "ExitWorktree",
      "RemoteTrigger",
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "AskUserQuestion",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet"
    ]
  },
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": false,
  "skillOverrides": {
    "design": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "loop": "user-invocable-only",
    "run": "user-invocable-only",
    "schedule": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only"
  },
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-wrapper.cmd"
  },
  "syncClaudeAiPlugins": false,
  "theme": "dark",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}
